{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "red-and-white-cleaning",
	"account_id": "45626a3f0c852a113bc5c894686e9195",
	"compatibility_date": "2026-06-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Smart placement (near the DB in Tokyo) made sense when every page hit
	// Supabase on every request. Public pages are now ISR-cached (DB hit at
	// most every 5 min), so pinning the Worker to Tokyo instead costs every
	// visitor (mostly Southern Ontario) a transoceanic round trip just to
	// serve cached HTML. Run near the visitor instead; the request-scoped
	// pool still keeps the remaining DB-heavy admin/dynamic routes fast.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"images": {
		// Enables next/image optimization (resize/re-encode) on Workers —
		// without this, /_next/image serves the original file unresized
		// regardless of the requested width.
		"binding": "IMAGES"
	},
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://redandwhitecleaningservices.com",
		"NEXT_PUBLIC_SUPABASE_URL": "https://yunjsitjhhjxpkrgjmgp.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl1bmpzaXRqaGhqeHBrcmdqbWdwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE0MDg4NzgsImV4cCI6MjA5Njk4NDg3OH0.JMKyoSyUPSvzeLpCuQ9L1hSLODU0Q6jz-17OgeX_BIQ",
		"AUTH_TRUST_HOST": "true",
		"AUTH_URL": "https://redandwhitecleaningservices.com"
	}
}
